# Copy to .env and fill in before running locally.

# Found in your ESPN league URL, e.g. fantasy.espn.com/football/team?leagueId=123456
ESPN_LEAGUE_ID=

# Current season, e.g. 2026
ESPN_SEASON_YEAR=2026

# Private-league auth cookies — extract from your browser's DevTools
# (Application/Storage > Cookies > fantasy.espn.com), with "URL decode" OFF
# so you copy the raw encoded values ESPN stored.
ESPN_S2=
ESPN_SWID={XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX}

# Where synced league JSON files are written (gitignored — personal league data)
DATA_DIR=data

# Frontend origin(s) allowed to call the API, comma-separated
CORS_ORIGINS=http://localhost:8000

# LLM for research materiality synthesis — OpenRouter for now; swap to a
# direct Anthropic key later by adding a new LLMAdapter, no other code
# changes needed.
# LLM_MODEL: openrouter/auto routes each request to whichever model best
# fits it (quality-optimized, not cost-optimized) — real per-token cost,
# billed to your OpenRouter balance, not free.
# LLM_FALLBACK_MODEL: used automatically if the primary model 402s
# (insufficient credits) — pick a real ":free" model as a safety net.
OPENROUTER_API_KEY=sk-or-your-key-here
LLM_MODEL=openrouter/auto
LLM_FALLBACK_MODEL=openai/gpt-oss-20b:free
